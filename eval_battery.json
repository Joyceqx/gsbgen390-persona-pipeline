        {"id": "bfi_e_r", "text": "is reserved",                          "anchor": "reserved",                       "trait": "Extraversion",      "reverse": true},
        {"id": "bfi_a",   "text": "is generally trusting",                "anchor": "generally trusting",             "trait": "Agreeableness",     "reverse": false},
        {"id": "bfi_c_r", "text": "tends to be lazy",                     "anchor": "tends to be lazy",               "trait": "Conscientiousness", "reverse": true},
        {"id": "bfi_n_r", "text": "is relaxed, handles stress well",      "anchor": "handles stress well",            "trait": "Neuroticism",       "reverse": true},
        {"id": "bfi_o_r", "text": "has few artistic interests",           "anchor": "few artistic interests",         "trait": "Openness",          "reverse": true},
        {"id": "bfi_e",   "text": "is outgoing, sociable",                "anchor": "outgoing",                       "trait": "Extraversion",      "reverse": false},
        {"id": "bfi_a_r", "text": "tends to find fault with others",      "anchor": "find fault with others",         "trait": "Agreeableness",     "reverse": true},
        {"id": "bfi_c",   "text": "does a thorough job",                  "anchor": "does a thorough job",            "trait": "Conscientiousness", "reverse": false},
        {"id": "bfi_n",   "text": "gets nervous easily",                  "anchor": "gets nervous easily",            "trait": "Neuroticism",       "reverse": false},
        {"id": "bfi_o",   "text": "has an active imagination",            "anchor": "active imagination",             "trait": "Openness",          "reverse": false}
      ]
    },
    {
      "id": "gss",
      "name": "GSS subset",
      "items": [
        {"id": "happy",    "text": "Taken all together, how would you say things are these days — would you say that you are…", "anchor": "Taken all together",        "scale": ["Very happy", "Pretty happy", "Not too happy"]},
        {"id": "trust",    "text": "Generally speaking, would you say that…",                                                  "anchor": "most people can be trusted","scale": ["Most people can be trusted", "You can't be too careful in dealing with people", "Depends"]},
